<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">

    <display-name>SunriseDentalClinic</display-name>
    <description>Enterprise Dental Appointment and Patient Management System - Colombo</description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration (30 mins) -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- =================================================================== -->
    <!-- SERVLET DECLARATIONS                                                -->
    <!-- =================================================================== -->

    <!-- Auth Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth/login</url-pattern>
        <url-pattern>/auth/logout</url-pattern>
        <url-pattern>/auth/profile</url-pattern>
    </servlet-mapping>

    <!-- Dashboard Servlet -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <!-- Patient Servlet -->
    <servlet>
        <servlet-name>PatientServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.PatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientServlet</servlet-name>
        <url-pattern>/patients</url-pattern>
        <url-pattern>/patients/new</url-pattern>
        <url-pattern>/patients/view</url-pattern>
        <url-pattern>/patients/edit</url-pattern>
        <url-pattern>/patients/search</url-pattern>
    </servlet-mapping>

    <!-- Appointment Servlet -->
    <servlet>
        <servlet-name>AppointmentServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.AppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentServlet</servlet-name>
        <url-pattern>/appointments</url-pattern>
        <url-pattern>/appointments/book</url-pattern>
        <url-pattern>/appointments/view</url-pattern>
        <url-pattern>/appointments/cancel</url-pattern>
        <url-pattern>/appointments/search</url-pattern>
    </servlet-mapping>

    <!-- Doctor Servlet -->
    <servlet>
        <servlet-name>DoctorServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.DoctorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorServlet</servlet-name>
        <url-pattern>/doctor/schedule</url-pattern>
        <url-pattern>/doctor/treatment</url-pattern>
        <url-pattern>/doctor/update-status</url-pattern>
    </servlet-mapping>

    <!-- Billing Servlet -->
    <servlet>
        <servlet-name>BillingServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.BillingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillingServlet</servlet-name>
        <url-pattern>/billing/queue</url-pattern>
        <url-pattern>/billing/generate</url-pattern>
        <url-pattern>/billing/pay</url-pattern>
        <url-pattern>/billing/invoice</url-pattern>
    </servlet-mapping>

    <!-- Report Servlet -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/reports/monthly</url-pattern>
        <url-pattern>/reports/annual</url-pattern>
    </servlet-mapping>

    <!-- User Management Servlet -->
    <servlet>
        <servlet-name>UserManagementServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.UserManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserManagementServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
        <url-pattern>/admin/users/create</url-pattern>
        <url-pattern>/admin/users/toggle</url-pattern>
        <url-pattern>/admin/users/reset-password</url-pattern>
    </servlet-mapping>

    <!-- Doctor Management Servlet -->
    <servlet>
        <servlet-name>DoctorManagementServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.DoctorManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorManagementServlet</servlet-name>
        <url-pattern>/admin/doctors</url-pattern>
        <url-pattern>/admin/doctors/edit</url-pattern>
    </servlet-mapping>

    <!-- Treatment Management Servlet -->
    <servlet>
        <servlet-name>TreatmentManagementServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.TreatmentManagementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TreatmentManagementServlet</servlet-name>
        <url-pattern>/admin/treatments</url-pattern>
        <url-pattern>/admin/treatments/create</url-pattern>
        <url-pattern>/admin/treatments/edit</url-pattern>
    </servlet-mapping>

    <!-- Help Servlet -->
    <servlet>
        <servlet-name>HelpServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.HelpServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HelpServlet</servlet-name>
        <url-pattern>/help</url-pattern>
    </servlet-mapping>

    <!-- REST API Servlets -->
    <servlet>
        <servlet-name>ApiAppointmentServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.api.ApiAppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiAppointmentServlet</servlet-name>
        <url-pattern>/api/appointments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiDoctorAvailabilityServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.api.ApiDoctorAvailabilityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiDoctorAvailabilityServlet</servlet-name>
        <url-pattern>/api/doctors/availability</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiPatientSearchServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.api.ApiPatientSearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiPatientSearchServlet</servlet-name>
        <url-pattern>/api/patients/search</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiAnalyticsServlet</servlet-name>
        <servlet-class>com.sunrisedental.controller.api.ApiAnalyticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiAnalyticsServlet</servlet-name>
        <url-pattern>/api/analytics</url-pattern>
    </servlet-mapping>

    <!-- =================================================================== -->
    <!-- FILTERS                                                             -->
    <!-- =================================================================== -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.sunrisedental.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>com.sunrisedental.filter.RoleFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/doctor/*</url-pattern>
        <url-pattern>/billing/*</url-pattern>
        <url-pattern>/reports/*</url-pattern>
    </filter-mapping>

    <!-- =================================================================== -->
    <!-- ERROR PAGES                                                         -->
    <!-- =================================================================== -->
    <error-page>
        <error-code>404</error-code>
        <location>/error404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/error500.jsp</location>
    </error-page>

</web-app>
